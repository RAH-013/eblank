// use prisma-8

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String    @id
  expiresAt TimestamptzString
  token     String    @unique
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString
  ipAddress String?
  userAgent String?

  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "session_userId_idx")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  TimestamptzString?
  refreshTokenExpiresAt TimestamptzString?
  scope                 String?
  password              String?
  createdAt             TimestamptzString @default(now())
  updatedAt             TimestamptzString

  user                  User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "account_userId_idx")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  TimestamptzString
  createdAt  TimestamptzString @default(now())
  updatedAt  TimestamptzString @default(now())

  @@index([identifier], map: "verification_identifier_idx")
}