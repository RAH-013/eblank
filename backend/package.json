    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/composer": "0.23.0",
    "@prisma/composer-prisma-cloud": "0.23.0",
    "@prisma/orm-postgres": "8.0.0-rc.12",
    "alchemy": "2.0.0-beta.78",
    "axios": "^1.20.0",
    "better-auth": "^1.7.6",
    "express": "^5.2.1",
    "joi": "^18.2.9",
    "pg": "^8.23.0",
